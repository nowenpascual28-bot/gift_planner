  static const String supabaseAnonKey =
      sb_publishable_676DmsY7vdZI5zRgLCRBUw_wCZNdhI2;

  static bool get isConfigured =>
      supabaseUrl.trim().isNotEmpty &&
      supabaseAnonKey.trim().isNotEmpty &&
      !supabaseUrl.contains(https://dsfmsgxzmxykdetmahat.supabase.co) &&
      !supabaseAnonKey.contains(sb_publishable_676DmsY7vdZI5zRgLCRBUw_wCZNdhI2);
}